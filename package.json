{
  "name": "kookoovaya-xanthi-menu",
  "version": "1.0.0",
  "private": true,
  "description": "Kookoovaya Xanthi — visionOS-style menu website. Next.js + Payload CMS. SQLite locally, Neon Postgres in production via DATABASE_URL.",
  "type": "module",
  "scripts": {
    "predev": "payload generate:importmap",
    "prebuild": "payload generate:importmap",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "tsx src/seed/seed.ts",
    "seed:fresh": "tsx src/seed/seed.ts --fresh",
    "db:reset": "tsx src/seed/seed.ts --fresh",
    "migrate:create": "payload migrate:create",
    "migrate": "payload migrate",
    "migrate:status": "payload migrate:status",
    "migrate:fresh": "payload migrate:fresh --forceAcceptWarning",
    "migrate:down": "payload migrate:down"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.89.0",
    "@payloadcms/db-sqlite": "^3.40.0",
    "@payloadcms/next": "^3.40.0",
    "@payloadcms/payload-cloud": "^3.40.0",
    "@payloadcms/richtext-lexical": "^3.40.0",
    "@payloadcms/storage-s3": "^3.89.0",
    "cross-env": "^7.0.3",
    "framer-motion": "^12.0.0",
    "graphql": "^16.9.0",
    "lucide-react": "^0.469.0",
    "next": "15.4.11",
    "payload": "^3.40.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.20.2"
  }
}
