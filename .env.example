# ---- Local (SQLite, default) ----
DATABASE_URL=file:./dev.db
PAYLOAD_SECRET=please-set-a-32-char-secret-in-vercel-env
NEXT_PUBLIC_SITE_NAME=Kookoovaya Xanthi

# ---- Production (Neon Postgres on Vercel) ----
# In Vercel Dashboard > Project > Settings > Environment Variables, set:
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/DBNAME?sslmode=require
#   PAYLOAD_SECRET=<long random 32+ chars, e.g. output of: openssl rand -base64 32>
# Then redeploy. No code change needed — the app auto-switches to Postgres
# when DATABASE_URL starts with postgres:// or postgresql://.
#
# Seed production from your Windows machine (PowerShell):
#   $env:DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.neon.tech/DBNAME?sslmode=require"
#   $env:PAYLOAD_SECRET="your-production-secret"
#   npm run seed
#
# Reset / refresh production (WIPE + reseed):
#   $env:DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.neon.tech/DBNAME?sslmode=require"
#   $env:PAYLOAD_SECRET="your-production-secret"
#   npm run seed:fresh
