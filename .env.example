# ---------- Local dev (SQLite file, single app) ----------
DATABASE_URI=file:./dev.db
PAYLOAD_SECRET=kazanoba-dev-secret-change-me-please-32chars
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---------- Production (Postgres) ----------
# 1. Create a Postgres DB (local Postgres, Neon, Supabase, etc.) and put its
#    connection string here. The app picks the Postgres adapter automatically
#    when DATABASE_URI starts with "postgres".
# DATABASE_URI=postgres://user:password@host:5432/kazanoba
# 2. Long random secret (generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# PAYLOAD_SECRET=<paste-64-hex-chars-here>
# 3. Your public production URL (used for admin links, emails, OpenGraph)
# NEXT_PUBLIC_SERVER_URL=https://your-domain.com
