# ---------- Local dev (SQLite file, single app) ----------
DATABASE_URL=file:./dev.db
PAYLOAD_SECRET=kazanoba-dev-secret-change-me-please-32chars
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---------- Production (Postgres, e.g. Neon on Vercel) ----------
# 1. The app reads DATABASE_URL (what Vercel auto-provides) and falls back to
#    DATABASE_URI. It picks the Postgres adapter automatically when the value
#    starts with "postgres". Use the POOLED Neon URL on serverless, with sslmode.
# DATABASE_URL=postgres://user:password@host-pooler.neon.tech:5432/kazanoba?sslmode=require
# 2. Long random secret (generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# PAYLOAD_SECRET=<paste-64-hex-chars-here>
# 3. Your public production URL (used for admin links, emails, OpenGraph)
# NEXT_PUBLIC_SERVER_URL=https://your-domain.com
